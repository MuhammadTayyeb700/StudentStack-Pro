# Copy to .streamlit/secrets.toml (git-ignored) for local use,
# or paste into Streamlit Cloud > App settings > Secrets.
GROQ_API_KEY = "gsk_your_key_here"
# ACCESS_CODE = "choose-a-long-passphrase"   # optional: gate the whole app
# SESSION_LIMIT = 60                          # optional: AI requests per browser session (0 = unlimited)
# DAILY_LIMIT = 500                           # optional: AI requests per day, all visitors (0 = unlimited)
